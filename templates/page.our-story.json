    "intro": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.story-intro {\n  max-width: 720px;\n  margin: 0 auto;\n  padding: 5rem 2rem;\n  text-align: center;\n}\n.story-intro__lead {\n  font-family: var(--font-heading-family);\n  font-size: clamp(1.4rem, 3vw, 1.8rem);\n  line-height: 1.6;\n  color: #3D2314;\n  margin: 0 0 2rem;\n}\n.story-intro__body {\n  font-size: 1.05rem;\n  line-height: 1.8;\n  color: #5a3e2e;\n  margin: 0;\n}\n.story-intro__divider {\n  width: 60px;\n  height: 2px;\n  background: #D4956A;\n  margin: 2.5rem auto;\n  border: none;\n}\n</style>\n<div class=\"story-intro\">\n  <p class=\"story-intro__lead\">The Cocoa Circle was born from a belief that the world deserves better cocoa &mdash; cocoa that honours the craft of farming, the art of baking, and the planet we share.</p>\n  <hr class=\"story-intro__divider\">\n  <p class=\"story-intro__body\">In 2024, we set out to build a direct bridge between cocoa lovers in Europe and the extraordinary farmers of Central America. No middlemen. No compromises. Just pure, traceable, soul-stirring cocoa.</p>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
