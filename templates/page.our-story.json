    "farm_section_title": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.story-section-title {\n  text-align: center;\n  padding: 5rem 2rem 1rem;\n  background: #FFF8F0;\n}\n.story-section-title__eyebrow {\n  font-size: 0.8rem;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: #D4956A;\n  margin-bottom: 1rem;\n}\n.story-section-title__heading {\n  font-family: var(--font-heading-family);\n  font-size: clamp(1.8rem, 4vw, 2.8rem);\n  color: #3D2314;\n  margin: 0 0 1rem;\n  font-weight: 400;\n}\n.story-section-title__sub {\n  font-size: 1.05rem;\n  color: #5a3e2e;\n  max-width: 600px;\n  margin: 0 auto;\n  line-height: 1.7;\n}\n</style>\n<div class=\"story-section-title\">\n  <p class=\"story-section-title__eyebrow\">Our Farms</p>\n  <h2 class=\"story-section-title__heading\">The People Behind Your Cocoa</h2>\n  <p class=\"story-section-title__sub\">We don&rsquo;t just source cocoa &mdash; we build relationships. Meet the five families who make The Cocoa Circle possible.</p>\n</div>",
