    "values": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.story-values {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 0;\n  background: #3D2314;\n}\n@media (max-width: 749px) {\n  .story-values { grid-template-columns: 1fr; }\n}\n.story-value {\n  padding: 4rem 2.5rem;\n  text-align: center;\n  color: #FFF8F0;\n  border-right: 1px solid rgba(255,248,240,0.1);\n}\n.story-value:last-child { border-right: none; }\n@media (max-width: 749px) {\n  .story-value {\n    border-right: none;\n    border-bottom: 1px solid rgba(255,248,240,0.1);\n    padding: 3rem 2rem;\n  }\n  .story-value:last-child { border-bottom: none; }\n}\n.story-value__number {\n  font-family: var(--font-heading-family);\n  font-size: 3rem;\n  color: #D4956A;\n  margin-bottom: 0.5rem;\n  line-height: 1;\n}\n.story-value__label {\n  font-family: var(--font-body-family);\n  font-size: 0.75rem;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  opacity: 0.7;\n  margin-bottom: 1rem;\n}\n.story-value__text {\n  font-size: 0.95rem;\n  line-height: 1.7;\n  opacity: 0.9;\n  max-width: 280px;\n  margin: 0 auto;\n}\n</style>\n<div class=\"story-values\">\n  <div class=\"story-value\">\n    <div class=\"story-value__number\">5</div>\n    <div class=\"story-value__label\">Partner Farms</div>\n    <p class=\"story-value__text\">Family-owned cacao farms across Central America, each selected for their exceptional Criollo beans and sustainable practices.</p>\n  </div>\n  <div class=\"story-value\">\n    <div class=\"story-value__number\">100%</div>\n    <div class=\"story-value__label\">Pure &amp; Traceable</div>\n    <p class=\"story-value__text\">No fillers, no additives, no blending. Every batch is traceable to the exact farm that grew it.</p>\n  </div>\n  <div class=\"story-value\">\n    <div class=\"story-value__number\">2&times;</div>\n    <div class=\"story-value__label\">Above Fair Trade</div>\n    <p class=\"story-value__text\">We pay our farmers more than double the fair-trade minimum, because exceptional cocoa deserves exceptional compensation.</p>\n  </div>\n</div>",
