    "process": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.story-process {\n  background: #F5EDE4;\n  padding: 5rem 2rem;\n}\n.story-process__inner {\n  max-width: 1000px;\n  margin: 0 auto;\n  text-align: center;\n}\n.story-process__eyebrow {\n  font-size: 0.8rem;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: #D4956A;\n  margin-bottom: 1rem;\n}\n.story-process__heading {\n  font-family: var(--font-heading-family);\n  font-size: clamp(1.8rem, 4vw, 2.5rem);\n  color: #3D2314;\n  margin: 0 0 3rem;\n  font-weight: 400;\n}\n.story-steps {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 2rem;\n  text-align: center;\n}\n@media (max-width: 749px) {\n  .story-steps { grid-template-columns: repeat(2, 1fr); }\n}\n.story-step__number {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: #3D2314;\n  color: #FFF8F0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-heading-family);\n  font-size: 1.1rem;\n  margin-bottom: 1rem;\n}\n.story-step__title {\n  font-family: var(--font-heading-family);\n  font-size: 1.1rem;\n  color: #3D2314;\n  margin-bottom: 0.5rem;\n}\n.story-step__text {\n  font-size: 0.85rem;\n  line-height: 1.7;\n  color: #5a3e2e;\n}\n.story-process__img {\n  width: 100%;\n  max-width: 1000px;\n  margin: 3rem auto 0;\n  border-radius: 8px;\n  display: block;\n}\n</style>\n<div class=\"story-process\">\n  <div class=\"story-process__inner\">\n    <p class=\"story-process__eyebrow\">From Tree to Table</p>\n    <h2 class=\"story-process__heading\">How Your Cocoa is Made</h2>\n    <div class=\"story-steps\">\n      <div class=\"story-step\">\n        <div class=\"story-step__number\">1</div>\n        <div class=\"story-step__title\">Harvested</div>\n        <p class=\"story-step__text\">Ripe cacao pods handpicked at peak flavour by our partner farmers.</p>\n      </div>\n      <div class=\"story-step\">\n        <div class=\"story-step__number\">2</div>\n        <div class=\"story-step__title\">Fermented</div>\n        <p class=\"story-step__text\">Beans fermented 5&ndash;7 days in wooden boxes to develop rich chocolate notes.</p>\n      </div>\n      <div class=\"story-step\">\n        <div class=\"story-step__number\">3</div>\n        <div class=\"story-step__title\">Sun-Dried</div>\n        <p class=\"story-step__text\">Slowly dried on raised beds, then hand-sorted for only the finest beans.</p>\n      </div>\n      <div class=\"story-step\">\n        <div class=\"story-step__number\">4</div>\n        <div class=\"story-step__title\">Crafted</div>\n        <p class=\"story-step__text\">Gently roasted and processed in the Netherlands into powder, drops, and nibs.</p>\n      </div>\n    </div>\n    <img class=\"story-process__img\" src=\"{{ 'story-fermentation.jpg' | asset_url }}\" alt=\"Cacao beans being processed and sorted\" loading=\"lazy\">\n  </div>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
